{
  "name": "zhikuyun-search",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=60000",
    "lint": "eslint ."
  },
  "dependencies": {
    "axios": "^1.9.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "vue": "^3.5.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.29",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.28.0",
    "eslint-plugin-vue": "^10.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.1.3"
  }
}
